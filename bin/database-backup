#!/usr/bin/env bash
set -euo pipefail
umask 077

database_url="${DATABASE_URL_UNPOOLED:-${DATABASE_URL:?Set DATABASE_URL or DATABASE_URL_UNPOOLED}}"
: "${BACKUP_PASSPHRASE:?Set BACKUP_PASSPHRASE}"
if [ "${#BACKUP_PASSPHRASE}" -lt 32 ]; then
  echo "Use a randomly generated backup passphrase of at least 32 characters." >&2
  exit 1
fi
output="${1:?Pass a new output file ending in .gpg}"
if [ -e "$output" ] || [[ "$output" != *.gpg ]]; then
  echo "Choose a new output file ending in .gpg." >&2
  exit 1
fi

temporary=$(mktemp -d)
trap 'rm -f -- "$temporary/database.dump" "$temporary/database.dump.gpg"; rmdir -- "$temporary"' EXIT
pg_dump --dbname="$database_url" --format=custom --no-owner --no-acl --file="$temporary/database.dump"
gpg --batch --pinentry-mode loopback --passphrase-fd 3 --symmetric \
  --cipher-algo AES256 --output "$temporary/database.dump.gpg" \
  "$temporary/database.dump" 3<<<"$BACKUP_PASSPHRASE"
mv -- "$temporary/database.dump.gpg" "$output"
echo "Encrypted backup created."
