{
  "name": "reachoutt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "serve": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "heroku-postbuild": "npm run build",
    "test:preview": "playwright test --config playwright.preview.config.js",
    "format": "prettier --write \"frontend/src/**/*.{js,vue}\" \"test/{browser,preview}/**/*.js\" \"*.config.js\" package.json",
    "format:check": "prettier --check \"frontend/src/**/*.{js,vue}\" \"test/{browser,preview}/**/*.js\" \"*.config.js\" package.json"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@neon/config": "^1.12.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
