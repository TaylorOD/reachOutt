PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Production also needs DATABASE_URL and SECRET_KEY_BASE.
# Neon deploy writes DATABASE_URL and DATABASE_URL_UNPOOLED into .env.local.
# Keep both private. Use bundle exec ruby bin/migrate for direct migrations.
# Generate a new secret with: bundle exec rails secret
# Email is the default reminder channel. SMS requires explicit configuration.
REMINDER_CHANNEL=email
SMS_ENABLED=false
SMS_ALLOWED_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEWS_API_KEY=

APP_URL=http://localhost:3000
MAIL_FROM=reachoutt@example.test
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
